        9) wget -q ${REPO}zivpn/fix-zivpn.sh -O /usr/local/bin/fix-zivpn.sh && chmod +x /usr/local/bin/fix-zivpn.sh && /usr/local/bin/fix-zivpn.sh && read -p "Press any key to back" && /usr/local/bin/zivpn-manager ;;
        x) menu ;;
        *) echo "You pressed it wrong" ;;
    esac
}


