    result=$(_create_account_logic "$password" "$days")
    
    # Display logic remains here for interactive mode if successful
    if [[ "$result" == "Success"* ]]; then
        local db_file="/etc/zivpn/users.db"
        local user_line
        user_line=$(grep "^${password}:" "$db_file")
        if [ -n "$user_line" ]; then
